{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spyder-chat-devnet",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{"name":"CHAT_HUB","class_name":"ChatHub"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["ChatHub"]}]
}
